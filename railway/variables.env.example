APP_NAME="LayananBisnis eProcurement"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN
APP_KEY=
BID_ENCRYPTION_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}
REDIS_CLIENT=predis
REDIS_URL=${{Redis.REDIS_URL}}
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
SCANNER_HOST=
SCANNER_PORT=3310
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="LayananBisnis"
ERP_ALLOWED_HOSTS=
SERVICE_ROLE=web

REDIS_QUEUE_RETRY_AFTER=180
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_HOSTS=
